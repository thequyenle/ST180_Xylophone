<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--    flOutSide - Background dimmed area -->
    <FrameLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <!--    layoutMain - Dialog container -->
        <LinearLayout
            android:id="@+id/layoutMain"
            android:layout_width="320dp"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!--    tvTitle - Dialog title -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chewy_regular"
                android:gravity="center"
                android:layout_marginTop="14dp"
                android:layout_marginHorizontal="60dp"
                android:text="@string/name_the_recording"
                android:textColor="@android:color/white"
                android:textSize="16sp" />


            <!--    etRecordingName - EditText for name input -->
            <EditText
                android:id="@+id/etRecordingName"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/chewy_regular"
                android:gravity="center"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_edt"
                android:hint="@string/enter_recording_name"
                android:textColorHint="#808080"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#808080"
                android:textSize="16sp" />


            <!--    Buttons container -->
            <FrameLayout
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="50dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                >
                <include
                    android:id="@+id/flBottom"
                    layout="@layout/layout_bottom" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>
</layout>
