<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity_app.main.SongListActivity"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app"
        android:orientation="vertical">


        <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:background="@color/transparent"
            android:layout_height="wrap_content">
            <!-- Action Bar -->
            <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar"
                />
        </FrameLayout>


        <!-- Filter Tabs (Optional) -->
        <LinearLayout
            android:id="@+id/tabMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:weightSum="2"
            android:background="@drawable/tab_selected_song"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.xylophone.core.custom.text.DoubleStrokeTextView
                android:id="@+id/allSong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:gravity="center"
                android:text="Song"
                app:outerStrokeColor="#E47E17"
                app:outerStrokeWidth="4dp"
                android:fontFamily="@font/chewy_regular"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <com.xylophone.core.custom.text.DoubleStrokeTextView
                android:layout_marginTop="6dp"
                android:id="@+id/myRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:gravity="center"
                android:textSize="16sp"
               android:fontFamily="@font/chewy_regular"
                android:text="Record"
                android:textColor="#808080"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- RecyclerView for Songs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-2dp"
            android:clipToPadding="false"
            android:padding="8dp"
            android:background="@drawable/bg_song"
            tools:listitem="@layout/item_song" />



    </LinearLayout>

</layout>
