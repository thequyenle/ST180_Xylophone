<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity_app.main.SongListActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_app"
            android:orientation="vertical">


            <FrameLayout
                android:id="@+id/layoutActionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@color/transparent">
                <!-- Action Bar -->
                <include
                    android:id="@+id/actionBar"
                    layout="@layout/layout_actionbar" />
            </FrameLayout>


            <!-- Filter Tabs (Optional) -->
            <LinearLayout
                android:id="@+id/tabMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/tab_selected_song"
                android:gravity="center"
                android:clipToOutline="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="8dp"
                android:weightSum="2">

                <com.xylophone.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/allSong"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1.4"
                    android:paddingBottom="3dp"
                    android:fontFamily="@font/chewy_regular"
                    android:gravity="center"
                    android:text="Song"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:outerStrokeColor="#E47E17"
                    app:outerStrokeWidth="4dp" />

                <com.xylophone.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/myRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="0.6"
                    android:fontFamily="@font/chewy_regular"
                    android:gravity="center"
                    android:text="Record"
                    android:textColor="#808080"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- RecyclerView for Songs -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_song"
                android:clipToPadding="false"
                android:padding="8dp"
                tools:listitem="@layout/item_song" />


            <!-- RecyclerView for Songs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSongs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-2dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp"
                tools:listitem="@layout/item_song" />




        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_no_item"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/no_item"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:background="@drawable/ic_no_item"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias=".1" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/chewy_regular"
                android:text="No record here"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/no_item" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
