<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_play"
    tools:context=".activity_app.main.PlayActivity">

    <ImageView
        android:id="@+id/btnHome"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/img2"
        app:layout_constraintBottom_toBottomOf="@id/img2"/>

    <ImageView
        android:id="@+id/img1"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/xylo_selected"
        app:layout_constraintBottom_toBottomOf="@id/img2"
        app:layout_constraintEnd_toStartOf="@id/img2"
        app:layout_constraintTop_toTopOf="@id/img2" />

    <ImageView
        android:id="@+id/img2"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/piano_selected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img3"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/guitar_selected"
        app:layout_constraintBottom_toBottomOf="@id/img2"
        app:layout_constraintStart_toEndOf="@id/img2"
        app:layout_constraintTop_toTopOf="@id/img1" />
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnRecord"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/record_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img2"
        app:layout_constraintBottom_toBottomOf="@id/img2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record"
            android:fontFamily="@font/chewy_regular"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>





    <FrameLayout
        android:id="@+id/btnStop"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:background="@drawable/stop_ic"
        android:visibility="invisible"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img2"
        app:layout_constraintBottom_toBottomOf="@id/img2">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:gravity="center"
            android:layout_gravity="center"
            android:fontFamily="@font/chewy_regular"
            android:textSize="16sp"
            android:textColor="@color/white"
            />

    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnCount"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_count"
        android:scaleType="fitXY"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/btnStop"
        app:layout_constraintTop_toTopOf="@id/img2"
        app:layout_constraintBottom_toBottomOf="@id/img2"
        >
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_marginEnd="13dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:fontFamily="@font/chewy_regular"
            android:textSize="16sp"
            android:textColor="@color/white"

            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnMusic"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/music_bg"
        app:layout_constraintEnd_toStartOf="@id/btnRecord"
        app:layout_constraintTop_toTopOf="@id/img2"
        app:layout_constraintBottom_toBottomOf="@id/img2">

        <ImageView
            android:id="@+id/ic_music"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_music"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="14dp"/>

        
        <TextView
            android:id="@+id/idMusic"
            android:paddingStart="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:text="@string/music"
            android:layout_marginEnd="20dp"
            android:visibility="visible"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/chewy_regular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/ic_music"
            app:layout_constraintBottom_toBottomOf="parent"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>






    <ImageView
        android:id="@+id/frameMusic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:layout_marginTop="-20dp"
        android:src="@drawable/frame_behind"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img2"/>

    <ImageView
        android:id="@+id/btnDo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.72"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/btn_do"
        app:layout_constraintStart_toStartOf="@id/frameMusic"
        app:layout_constraintEnd_toStartOf="@id/btnRe"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        app:layout_constraintHorizontal_chainStyle="packed"
        />
    <ImageView
        android:id="@+id/btnRe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.685"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/btn_re"
        android:scaleType="fitXY"
        app:layout_constraintStart_toEndOf="@id/btnDo"
        app:layout_constraintEnd_toStartOf="@id/btnMi"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />
    <ImageView
        android:id="@+id/btnMi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.655"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/btn_mi"
        android:scaleType="fitXY"
        app:layout_constraintStart_toEndOf="@id/btnRe"
        app:layout_constraintEnd_toStartOf="@id/btnFa"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />


    <ImageView
        android:id="@+id/btnFa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/btn_fa"
        android:scaleType="fitXY"
        app:layout_constraintHeight_percent="0.625"
        app:layout_constraintStart_toEndOf="@id/btnMi"
        app:layout_constraintEnd_toStartOf="@id/btnSol"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />
    <ImageView
        android:id="@+id/btnSol"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintHeight_percent="0.595"
        android:src="@drawable/btn_sol"
        android:scaleType="fitXY"
        app:layout_constraintStart_toEndOf="@id/btnFa"
        app:layout_constraintEnd_toStartOf="@id/btnLa"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />
    <ImageView
        android:id="@+id/btnLa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/btn_la"
        android:scaleType="fitXY"
        app:layout_constraintHeight_percent="0.585"
        app:layout_constraintStart_toEndOf="@id/btnSol"
        app:layout_constraintEnd_toStartOf="@id/btnSi"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />
    <ImageView
        android:id="@+id/btnSi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/btn_si"
        android:scaleType="fitXY"
        app:layout_constraintHeight_percent=".568"
        app:layout_constraintStart_toEndOf="@id/btnLa"
        app:layout_constraintEnd_toStartOf="@id/btnDo2"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />

    <ImageView
        android:id="@+id/btnDo2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="80dp"
        android:src="@drawable/btn_do2"
        android:scaleType="fitXY"
        app:layout_constraintHeight_percent=".53"
        app:layout_constraintStart_toEndOf="@id/btnSi"
        app:layout_constraintEnd_toEndOf="@id/frameMusic"
        app:layout_constraintTop_toTopOf="@id/frameMusic"
        app:layout_constraintBottom_toBottomOf="@id/frameMusic"
        />

    <!-- Musical note overlay container - positioned on top of all buttons -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <!-- Sun guide icon (learning mode) -->
        <ImageView
            android:id="@+id/imgSunGuide"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/sun"
            android:visibility="gone"
            android:elevation="30dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>