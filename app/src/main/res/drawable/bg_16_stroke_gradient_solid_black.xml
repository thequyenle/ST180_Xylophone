<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:centerColor="#FF5959"
                android:endColor="#FF5959"
                android:startColor="#FF5959" />
            <padding
                android:bottom="1.5dp"
                android:left="1.5dp"
                android:right="1.5dp"
                android:top="1.5dp" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="10.5dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>